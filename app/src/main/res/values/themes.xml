<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Smstextmessagesmessenger"
        parent="Theme.AppCompat.Light.NoActionBar">

        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>

    </style>

    <style name="Theme.CallEndPopup" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">#FFF1F1F1</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="Theme.CallEndFullscreen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">#FFF1F1F1</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

</resources>
